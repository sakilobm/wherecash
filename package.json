    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.108.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "expo": "~56.0.9",
    "expo-blur": "^56.0.3",
    "expo-constants": "^56.0.17",
    "expo-dev-client": "~56.0.20",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-font": "^56.0.5",
    "expo-haptics": "^56.0.3",
    "expo-linear-gradient": "^56.0.4",
    "expo-linking": "~56.0.13",
    "expo-notifications": "~56.0.17",
    "expo-router": "^56.2.9",
    "expo-secure-store": "^56.0.4",
    "expo-splash-screen": "~56.0.13",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "^4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.8.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "^56.0.14",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "eas build --platform android --profile production --local",
    "build:android-preview": "eas build --platform android --profile preview --local",
    "bump-version": "node scripts/export-build.js --command none",
    "export:prod": "node scripts/export-build.js --env production --command \"npx expo export\"",
    "export:dev": "node scripts/export-build.js --env development --command \"npx expo export\"",
    "build:prod": "node scripts/export-build.js --env production --command \"eas build --platform android --profile production --local\"",
    "build:preview": "node scripts/export-build.js --env development --command \"eas build --platform android --profile preview --local\"",
    "build:prod-local": "node scripts/export-build.js --env production --command \"npx expo prebuild --clean && cd android && gradlew assembleRelease\"",
    "build:prod-local-aab": "node scripts/export-build.js --env production --command \"npx expo prebuild --clean && cd android && gradlew bundleRelease\"",
    "release:aab": "node scripts/build-prod-aab.js"
  },
  "private": true
}
